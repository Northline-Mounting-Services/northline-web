{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northline-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "HOME_STATE",
      "id": "184f666845d04ee99bec80b54b9be1cf",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
