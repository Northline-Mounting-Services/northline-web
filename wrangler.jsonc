{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northline-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/service-area",
      "/service-area/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "HOME_STATE",
      "id": "184f666845d04ee99bec80b54b9be1cf",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "northline-core",
      "database_id": "7b5910dd-eaa0-44f4-9827-112f8a45f2ce",
      "remote": true
    }
  ],
  "services": [
    {
      "binding": "NORTHLINE_ADMIN",
      "service": "northline-admin"
    }
  ],
  "observability": {
    "enabled": true
  }
}
