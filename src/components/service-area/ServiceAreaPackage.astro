  aria-labelledby="nl-sa-package-heading"
  aria-busy="true"
  data-sa-package
  hidden
>
  <div class="nl-sa-package__inner">
    <div class="nl-sa-package__copy">
      <p class="nl-sa-package__eyebrow">Package</p>

      <h2
        class="nl-sa-package__name"
        id="nl-sa-package-heading"
        data-sa-package-name
      ></h2>

      <p
        class="nl-sa-package__description"
        data-sa-package-description
