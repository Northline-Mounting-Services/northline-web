<script>
    const root = document.querySelector("[data-northline-footer]");

    if (root) {
        const fullButton = root.querySelector(".nl-full-toggle");
        const fullLabel = root.querySelector(".nl-full-label");
        const panel = root.querySelector("#nl-full-panel");
        const panelInner = root.querySelector("#nl-panel-inner");

        const legalButton = root.querySelector(".nl-legal-toggle");
        const legalDetail = root.querySelector("#nl-legal-detail");

        let fullOpen = false;
        let legalOpen = false;

        const updateFull = () => {
            if (!fullButton || !fullLabel || !panel || !panelInner) return;

            panel.classList.toggle("is-open", fullOpen);
            fullButton.setAttribute("aria-expanded", String(fullOpen));
            panel.setAttribute("aria-hidden", String(!fullOpen));
            fullLabel.textContent = fullOpen ? "CLOSE" : "FULL SITE";

            if (fullOpen) {
                panelInner.removeAttribute("inert");
            } else {
                panelInner.setAttribute("inert", "");
            }
        };

        const updateLegal = () => {
            if (!legalButton || !legalDetail) return;

            legalButton.setAttribute("aria-expanded", String(legalOpen));
            legalDetail.setAttribute("aria-hidden", String(!legalOpen));
            legalDetail.classList.toggle("is-open", legalOpen);
            legalButton.setAttribute(
                "aria-label",
                legalOpen ? "Hide legal business name" : "Show legal business name"
            );
        };

        fullButton?.addEventListener("click", () => {
            fullOpen = !fullOpen;
            updateFull();
        });

        legalButton?.addEventListener("click", () => {
            legalOpen = !legalOpen;
            updateLegal();
        });

        updateFull();
        updateLegal();
    }
</script>
