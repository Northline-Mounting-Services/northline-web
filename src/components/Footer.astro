---
import Calculator from "./Calculator.astro";

const year = new Date().getFullYear();

const services = [
    ["TV Mounting", "/tv-mounting"],
    ["Samsung Frame", "/tv-mounting/samsung-frame"],
    ["Above Fireplace", "/tv-mounting/above-fireplace"],
    ["Large TV", "/tv-mounting/large-tv"],
    ["Wire Concealment", "/tv-mounting/wire-concealment"],
];

const plan = [
    ["Calculate Price", null],
    ["AI Photo Quote", "/ai-tv-quote"],
    ["Book a Time", "/book"],
];

const support = [
    ["FAQ", "/faq"],
    ["Installation Guarantee", "/installation-guarantee"],
];

const policies = [
    ["Terms", "/terms"],
    ["Privacy", "/privacy"],
    ["Cookies", "/cookies"],
    ["Accessibility", "/accessibility"],
];

const serviceRegions = [
    {
        label: "North Fulton",
        cities: [
            ["Alpharetta", "/service-area/alpharetta-ga"],
            ["Johns Creek", "/service-area/johns-creek-ga"],
            ["Milton", "/service-area/milton-ga"],
            ["Roswell", "/service-area/roswell-ga"],
        ],
    },
    {
        label: "Forsyth & North",
        cities: [
            ["Cumming", "/service-area/cumming-ga"],
            ["Dawsonville", "/service-area/dawsonville-ga"],
            ["Ball Ground", "/service-area/ball-ground-ga"],
            ["Dahlonega", "/service-area/dahlonega-ga"],
            ["Jasper", "/service-area/jasper-ga"],
        ],
    },
    {
        label: "Gwinnett West / Central",
        cities: [
            ["Berkeley Lake", "/service-area/berkeley-lake-ga"],
            ["Buford", "/service-area/buford-ga"],
            ["Duluth", "/service-area/duluth-ga"],
            ["Norcross", "/service-area/norcross-ga"],
            ["Peachtree Corners", "/service-area/peachtree-corners-ga"],
            ["Sugar Hill", "/service-area/sugar-hill-ga"],
            ["Suwanee", "/service-area/suwanee-ga"],
        ],
    },
    {
        label: "Gwinnett East",
        cities: [
            ["Dacula", "/service-area/dacula-ga"],
            ["Grayson", "/service-area/grayson-ga"],
            ["Lawrenceville", "/service-area/lawrenceville-ga"],
            ["Lilburn", "/service-area/lilburn-ga"],
            ["Snellville", "/service-area/snellville-ga"],
            ["Winder", "/service-area/winder-ga"],
        ],
    },
    {
        label: "North Atlanta",
        cities: [
            ["Brookhaven", "/service-area/brookhaven-ga"],
            ["Chamblee", "/service-area/chamblee-ga"],
            ["Doraville", "/service-area/doraville-ga"],
            ["Dunwoody", "/service-area/dunwoody-ga"],
            ["Sandy Springs", "/service-area/sandy-springs-ga"],
        ],
    },
    {
        label: "Northwest",
        cities: [
            ["Acworth", "/service-area/acworth-ga"],
            ["Canton", "/service-area/canton-ga"],
            ["Holly Springs", "/service-area/holly-springs-ga"],
            ["Kennesaw", "/service-area/kennesaw-ga"],
            ["Marietta", "/service-area/marietta-ga"],
            ["Smyrna", "/service-area/smyrna-ga"],
            ["Vinings", "/service-area/vinings-ga"],
            ["Woodstock", "/service-area/woodstock-ga"],
        ],
    },
    {
        label: "Northeast",
        cities: [
            ["Braselton", "/service-area/braselton-ga"],
            ["Flowery Branch", "/service-area/flowery-branch-ga"],
            ["Gainesville", "/service-area/gainesville-ga"],
            ["Hoschton", "/service-area/hoschton-ga"],
            ["Oakwood", "/service-area/oakwood-ga"],
        ],
    },
];

const hours = [
    { day: "MON", value: "8 AM–5 PM", open: true },
    { day: "TUE", value: "8 AM–5 PM", open: true },
    { day: "WED", value: "8 AM–5 PM", open: true },
    { day: "THU", value: "8 AM–5 PM", open: true },
    { day: "FRI", value: "8 AM–5 PM", open: true },
    { day: "SAT", value: "8 AM–5 PM", open: true },
    { day: "SUN", value: "CLOSED", open: false },
];
---


<div class="northline-footer" data-northline-footer>
    <footer class="nl-root">

        <!-- EXPANDED FULL SITE -->
        <div class="nl-panel" id="nl-full-panel" aria-hidden="true">
            <div class="nl-panel-inner" id="nl-panel-inner" inert>
                <div class="nl-panel-content">

                    <!-- SYSTEM -->
                    <div class="nl-system-head nl-stage nl-stage-1">
                        <div class="nl-system-name">
                            <span class="nl-kicker">SYSTEM</span>
                            <span class="nl-title">NORTHLINE MOUNTING SERVICES</span>
                            <span class="nl-subtitle">FULL OPERATIONAL RECORD</span>
                        </div>

                        <div class="nl-meta">
                            <div class="nl-meta-cell">
                                <span class="nl-meta-label">SERVICE REGION</span>
                                <span class="nl-meta-value">NORTH ATLANTA</span>
                            </div>
                            <div class="nl-meta-cell">
                                <span class="nl-meta-label">SITE MAP</span>
                                <span class="nl-meta-value">PUBLIC SITE</span>
                            </div>
                            <div class="nl-meta-cell">
                                <span class="nl-meta-label">COVERAGE</span>
                                <span class="nl-meta-value">40 AREAS</span>
                            </div>
                            <div class="nl-meta-cell">
                                <span class="nl-meta-label">TIME ZONE</span>
                                <span class="nl-meta-value">ET</span>
                            </div>
                            <div class="nl-meta-cell">
                                <span class="nl-meta-label">BOOKING</span>
                                <span class="nl-meta-value">ONLINE</span>
                            </div>
                        </div>
                    </div>

                    <div class="nl-divider"></div>

                    <!-- 01 / 02 / 03 -->
                    <div class="nl-row-primary nl-stage nl-stage-2">

                        <section class="nl-module">
                            <div class="nl-module-head">
                                <span class="nl-number">01</span>
                                <span>SERVICE SYSTEM</span>
                            </div>
                            <nav class="nl-link-list" aria-label="Service system">
                                {services.map(([label, href]) => (
                                    <a class="nl-link" href={href}>
                                        <span>{label}</span>
                                        <span class="nl-link-arrow" aria-hidden="true">↗</span>
                                    </a>
                                ))}
                            </nav>
                        </section>

                        <section class="nl-module">
                            <div class="nl-module-head">
                                <span class="nl-number">02</span>
                                <span>COVERAGE</span>
                            </div>

                            <nav aria-label="Service areas">
                                <div class="nl-link-list nl-coverage-main">
                                    <a class="nl-link" href="/service-area">
                                        <span>Service Areas</span>
                                        <span class="nl-link-arrow" aria-hidden="true">↗</span>
                                    </a>
                                </div>

                                <div class="nl-coverage-grid">
                                    {serviceRegions.map((region) => (
                                        <div class="nl-coverage-group">
                                            <span class="nl-coverage-label">{region.label}</span>
                                            <div class="nl-coverage-cities">
                                                {region.cities.map(([name, href]) => (
                                                    <a class="nl-coverage-city" href={href}>{name}</a>
                                                ))}
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </nav>
                        </section>

                        <section class="nl-module">
                            <div class="nl-module-head">
                                <span class="nl-number">03</span>
                                <span>PLAN &amp; BOOK</span>
                            </div>
                            <nav class="nl-link-list" aria-label="Plan and book">
                                {plan.map(([label, href]) => (
                                    href ? (
                                        <a class="nl-link" href={href}>
                                            <span>{label}</span>
                                            <span class="nl-link-arrow" aria-hidden="true">↗</span>
                                        </a>
                                    ) : (
                                        <button type="button" class="nl-link nl-link-button" data-nl-open>
                                            <span>{label}</span>
                                            <span class="nl-link-arrow" aria-hidden="true">↗</span>
                                        </button>
                                    )
                                ))}
                            </nav>
                        </section>

                    </div>

                    <div class="nl-divider"></div>

                    <!-- 04 / 05 / 06 -->
                    <div class="nl-row-secondary nl-stage nl-stage-3">

                        <section class="nl-module nl-hours-module">
                            <div class="nl-module-head">
                                <span class="nl-number">04</span>
                                <span>SERVICE HOURS</span>
                            </div>

                            <div class="nl-hours-axis">
                                <span></span>
                                <div class="nl-hours-axis-times">
                                    <span>08</span>
                                    <span>11</span>
                                    <span>14</span>
                                    <span>17</span>
                                </div>
                                <span></span>
                            </div>

                            <div class="nl-hours">
                                {hours.map((item) => (
                                    <div class:list={["nl-hours-row", !item.open && "is-closed"]}>
                                        <span class="nl-day">{item.day}</span>
                                        <div class="nl-hours-track" aria-hidden="true">
                                            {item.open ? (
                                                <>
                                                    <span></span>
                                                    <span></span>
                                                    <span></span>
                                                </>
                                            ) : (
                                                <span class="nl-closed-track"></span>
                                            )}
                                        </div>
                                        <span class="nl-hours-value">{item.value}</span>
                                    </div>
                                ))}
                            </div>

                            <div class="nl-hours-note">
                                BOOKING WINDOWS · <strong>8–11 · 11–2 · 2–5</strong><br />
                                MON–SAT · EASTERN TIME
                            </div>
                        </section>

                        <section class="nl-module">
                            <div class="nl-module-head">
                                <span class="nl-number">05</span>
                                <span>CONTACT CHANNELS</span>
                            </div>

                            <div class="nl-contact">
                                <div class="nl-contact-item">
                                    <span class="nl-small-label">VOICE / SMS</span>
                                    <a class="nl-phone" href="tel:+14704709331">(470) 470-9331</a>
                                </div>

                                <div class="nl-contact-item">
                                    <span class="nl-small-label">EMAIL</span>
                                    <a class="nl-email" href="mailto:info@atltvmount.com">info@atltvmount.com</a>
                                </div>

                                <a class="nl-book" href="/book">
                                    <span>BOOK A TIME</span>
                                    <span aria-hidden="true">↗</span>
                                </a>

                                <a class="nl-link" href="/contact-us">
                                    <span>Contact</span>
                                    <span class="nl-link-arrow" aria-hidden="true">↗</span>
                                </a>
                            </div>
                        </section>

                        <section class="nl-module">
                            <div class="nl-module-head">
                                <span class="nl-number">06</span>
                                <span>SUPPORT</span>
                            </div>
                            <nav class="nl-link-list" aria-label="Support">
                                {support.map(([label, href]) => (
                                    <a class="nl-link" href={href}>
                                        <span>{label}</span>
                                        <span class="nl-link-arrow" aria-hidden="true">↗</span>
                                    </a>
                                ))}
                            </nav>
                        </section>

                    </div>

                    <div class="nl-divider"></div>

                    <!-- 07 / 08 / AGENT -->
                    <div class="nl-row-tertiary nl-stage nl-stage-4">

                        <section class="nl-module">
                            <div class="nl-module-head">
                                <span class="nl-number">07</span>
                                <span>POLICIES</span>
                            </div>
                            <nav class="nl-link-list" aria-label="Policies">
                                {policies.map(([label, href]) => (
                                    <a class="nl-link" href={href}>
                                        <span>{label}</span>
                                        <span class="nl-link-arrow" aria-hidden="true">↗</span>
                                    </a>
                                ))}
                            </nav>
                        </section>

                        <section class="nl-module">
                            <div class="nl-module-head">
                                <span class="nl-number">08</span>
                                <span>BUSINESS RECORD</span>
                            </div>

                            <div class="nl-record">
                                <div class="nl-record-row">
                                    <span class="nl-record-key">ENTITY</span>
                                    <span class="nl-record-value">Northline Mounting Services LLC.</span>
                                </div>
                                <div class="nl-record-row">
                                    <span class="nl-record-key">BRAND</span>
                                    <span class="nl-record-value">ATL TV Mount</span>
                                </div>
                                <div class="nl-record-row">
                                    <span class="nl-record-key">DOMAIN</span>
                                    <a class="nl-record-value nl-record-link" href="/">atltvmount.com</a>
                                </div>

                                <div class="nl-record-divider"></div>

                                <a class="nl-link" href="/about">
                                    <span>About</span>
                                    <span class="nl-link-arrow" aria-hidden="true">↗</span>
                                </a>
                                <a class="nl-link" href="/">
                                    <span>Home</span>
                                    <span class="nl-link-arrow" aria-hidden="true">↗</span>
                                </a>
                            </div>
                        </section>

                        <section class="nl-agent">
                            <span class="nl-small-label">AGENT INTERFACE</span>
                            <a class="nl-agent-link" href="/agent">
                                <span>/agent</span>
                                <span aria-hidden="true">↗</span>
                            </a>
                            <span class="nl-agent-description">
                                ACCESS POINT FOR AI AGENTS<br />AND AUTOMATED CLIENTS.
                            </span>
                        </section>

                    </div>

                </div>
            </div>
        </div>

        <!-- CONTROL RAIL -->
        <div class="nl-rail">
            <div class="nl-legal-zone">
                <div class="nl-copy-main">
                    <span class="nl-copyright">© {year} ATL TV MOUNT</span>
                    <button
                        class="nl-legal-toggle"
                        type="button"
                        aria-expanded="false"
                        aria-controls="nl-legal-detail"
                        aria-label="Show legal business name"
                    >
                        <span class="nl-caret" aria-hidden="true">▼</span>
                    </button>
                </div>

                <div class="nl-legal-detail" id="nl-legal-detail" aria-hidden="true">
                    <div class="nl-legal-detail-inner">
                        <div class="nl-legal-text">
                            NORTHLINE MOUNTING SERVICES LLC.<br />
                            ALL RIGHTS RESERVED.
                        </div>
                    </div>
                </div>
            </div>

            <div class="nl-full-zone">
                <button
                    class="nl-full-toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls="nl-full-panel"
                >
                    <span class="nl-full-label">FULL SITE</span>
                    <span class="nl-full-glyph" aria-hidden="true">↗</span>
                </button>
            </div>
        </div>

    </footer>

<Calculator />
</div>

<style>


    .northline-footer {
        display: block;
        width: 100%;
        height: auto;

        --paper: #F2F2EF;
        --paper-2: #EAEAE6;

        --ink: #202321;
        --muted: #747875;
        --rule: #DCDDD8;

        --machine: #222623;
        --machine-2: #2C312E;
        --machine-rule: #363B37;

        --light: #F2F2EF;
        --machine-text: #DDE0DB;
        --machine-muted: #8D958F;

        --accent: #A8BDB4;
        --accent-main: #536B64;

        font-family:
            "Wix Madefor Text",
            "Helvetica Neue",
            Arial,
            sans-serif;

        color: var(--ink);
        box-sizing: border-box;
    }


    .northline-footer *,
    .northline-footer *::before,
    .northline-footer *::after {
        box-sizing: border-box;
    }


    .northline-footer a {
        color: inherit;
        text-decoration: none;
    }


    .northline-footer button {
        font: inherit;
    }


    .nl-root {
        width: 100%;
        background: var(--paper);
        border-top: 1px solid var(--rule);
    }


    /* =========================
       EXPANDED MACHINE PANEL
    ========================== */

    .nl-panel {
        display: grid;
        grid-template-rows: 0fr;

        background: var(--machine);
        color: var(--light);

        transition:
            grid-template-rows
            420ms cubic-bezier(.2,.7,.2,1);
    }


    .nl-panel.is-open {
        grid-template-rows: 1fr;
    }


    .nl-panel-inner {
        min-height: 0;
        overflow: hidden;
    }


    .nl-panel-content {
        max-width: 1560px;
        margin: 0 auto;

        padding:
            clamp(28px, 3vw, 44px)
            clamp(24px, 4vw, 56px)
            36px;

        display: flex;
        flex-direction: column;
        gap: 28px;
    }


    .nl-stage {
        opacity: 0;
        transform: translateY(8px);

        transition:
            opacity 220ms linear,
            transform 320ms cubic-bezier(.2,.7,.2,1);
    }


    .nl-panel.is-open .nl-stage {
        opacity: 1;
        transform: translateY(0);
    }


    .nl-panel.is-open .nl-stage-1 {
        transition-delay: 40ms;
    }

    .nl-panel.is-open .nl-stage-2 {
        transition-delay: 120ms;
    }

    .nl-panel.is-open .nl-stage-3 {
        transition-delay: 200ms;
    }

    .nl-panel.is-open .nl-stage-4 {
        transition-delay: 280ms;
    }


    /* =========================
       SYSTEM HEADER
    ========================== */

    .nl-system-head {
        display: grid;
        grid-template-columns:
            minmax(260px, 1fr)
            minmax(520px, 1.6fr);

        gap: 32px 50px;
        align-items: end;
    }


    .nl-system-name {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }


    .nl-kicker,
    .nl-meta-label,
    .nl-number,
    .nl-small-label {
        font-family:
            ui-monospace,
            SFMono-Regular,
            Menlo,
            Monaco,
            Consolas,
            monospace;
    }


    .nl-kicker {
        font-size: 9px;
        letter-spacing: .22em;
        color: var(--machine-muted);
    }


    .nl-title {
        max-width: 520px;

        font-size: clamp(22px, 2vw, 29px);
        font-weight: 500;
        line-height: 1.05;
        letter-spacing: -.015em;
    }


    .nl-subtitle {
        font-family:
            ui-monospace,
            SFMono-Regular,
            Menlo,
            monospace;

        font-size: 10px;
        letter-spacing: .14em;
        color: var(--accent);
    }


    .nl-meta {
        display: grid;
        grid-template-columns: repeat(5, minmax(105px, 1fr));

        gap: 1px;

        background: var(--machine-rule);
        border: 1px solid var(--machine-rule);
    }


    .nl-meta-cell {
        min-width: 0;
        padding: 11px 12px;

        display: flex;
        flex-direction: column;
        gap: 5px;

        background: var(--machine);
    }


    .nl-meta-label {
        font-size: 8px;
        letter-spacing: .17em;
        color: var(--machine-muted);
    }


    .nl-meta-value {
        font-family:
            ui-monospace,
            SFMono-Regular,
            Menlo,
            monospace;

        font-size: 11px;
        letter-spacing: .05em;

        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    .nl-divider {
        height: 1px;
        background: var(--machine-rule);
    }


    /* =========================
       MODULES
    ========================== */

    .nl-row-primary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));

        gap: 32px 48px;
    }


    .nl-row-secondary,
    .nl-row-tertiary {
        display: grid;
        grid-template-columns:
            minmax(340px, 1.55fr)
            minmax(220px, 1fr)
            minmax(220px, 1fr);

        gap: 32px 48px;
    }


    .nl-module {
        min-width: 0;
    }


    .nl-module-head {
        display: flex;
        align-items: baseline;
        gap: 10px;

        margin-bottom: 10px;
        padding-bottom: 10px;

        border-bottom: 1px solid var(--machine-rule);

        font-size: 11px;
        font-weight: 600;
        letter-spacing: .16em;
    }


    .nl-number {
        flex: 0 0 auto;

        font-size: 10px;
        font-weight: 400;
        letter-spacing: .1em;

        color: var(--accent);
    }


    .nl-link-list {
        display: flex;
        flex-direction: column;
    }


    .nl-link-button {
        width: 100%;
        border: 0;
        background: transparent;
        font: inherit;
        text-align: left;
        cursor: pointer;
    }


    .nl-link {
        min-height: 30px;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;

        padding: 5px 0;

        color: var(--machine-text);

        font-size: 14px;
        line-height: 1.35;

        transition:
            color 140ms linear,
            padding-left 160ms cubic-bezier(.2,.7,.2,1);
    }


    .nl-link-arrow {
        opacity: 0;
        color: var(--accent);

        font-family:
            ui-monospace,
            SFMono-Regular,
            Menlo,
            monospace;

        font-size: 11px;

        transform: translateX(-4px);

        transition:
            opacity 140ms linear,
            transform 160ms cubic-bezier(.2,.7,.2,1);
    }


    .nl-link:hover {
        color: #FFFFFF;
        padding-left: 5px;
    }


    .nl-link:hover .nl-link-arrow {
        opacity: 1;
        transform: translateX(0);
    }


    .nl-link:focus-visible,
    .nl-agent-link:focus-visible,
    .nl-book:focus-visible,
    .nl-rail button:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 3px;
    }


    /* =========================
       HOURS
    ========================== */

    .nl-hours-axis {
        display: grid;
        grid-template-columns: 46px 1fr 90px;
        gap: 10px;

        margin-bottom: 6px;
    }


    .nl-hours-axis-times {
        display: flex;
        justify-content: space-between;

        font-family:
            ui-monospace,
            SFMono-Regular,
            Menlo,
            monospace;

        font-size: 8px;
        letter-spacing: .1em;

        color: var(--machine-muted);
    }


    .nl-hours {
        border-top: 1px solid var(--machine-rule);
        border-bottom: 1px solid var(--machine-rule);
    }


    .nl-hours-row {
        display: grid;
        grid-template-columns: 46px 1fr 90px;

        gap: 10px;
        align-items: center;

        min-height: 33px;

        border-bottom: 1px solid var(--machine-rule);
    }


    .nl-hours-row:last-child {
        border-bottom: 0;
    }


    .nl-day,
    .nl-hours-value {
        font-family:
            ui-monospace,
            SFMono-Regular,
            Menlo,
            monospace;

        font-size: 10px;
        letter-spacing: .07em;
    }


    .nl-day {
        color: var(--light);
    }


    .nl-hours-value {
        color: var(--machine-muted);
        text-align: right;
    }


    .nl-hours-track {
        min-width: 0;
        height: 9px;

        display: grid;
        grid-template-columns: repeat(3, 1fr);

        gap: 2px;
    }


    .nl-hours-track > span:not(.nl-closed-track) {
        display: block;

        background:
            repeating-linear-gradient(
                90deg,
                #56675F 0 5px,
                #425049 5px 10px
            );

        border-top: 1px solid #667A70;
        border-bottom: 1px solid #667A70;
    }


