---
// Home TV-mounting offer.
//
// One-TV pricing comes from /api/home-state.
// Multiple-TV package identity, price and description come from /api/packages.
// No package pricing is calculated in this component.

const quantities = [2, 3, 4];

const fallbackOne = "$99";
---

<section class="nl-package" aria-labelledby="nl-package-heading" data-package>
  <h2 class="nl-kicker" id="nl-package-heading">Package</h2>

  <div class="nl-tabs" role="tablist" aria-label="Package size">
    <button
      class="nl-tab is-active"
      type="button"
      role="tab"
      id="nl-tab-one"
      aria-selected="true"
      aria-controls="nl-panel-one"
      data-mode="one"
    >
      One TV
    </button>

    <button
      class="nl-tab"
      type="button"
      role="tab"
      id="nl-tab-multiple"
      aria-selected="false"
      aria-controls="nl-panel-multiple"
      data-mode="multiple"
    >
      Multiple TVs
    </button>
  </div>

  <div
    class="nl-panel"
    id="nl-panel-one"
    role="tabpanel"
    aria-labelledby="nl-tab-one"
    data-panel="one"
  >
    <p class="nl-price">
      <span class="nl-price__label">from</span>
      <span class="nl-price__value" data-price="one">{fallbackOne}</span>
    </p>

    <p class="nl-package__descriptor">
      Standard wall &middot; basic installation.
    </p>

    <button class="nl-action" type="button" data-nl-open>
      <span>Calculate price &amp; book</span>
      <span aria-hidden="true">&rarr;</span>
    </button>
  </div>

  <div
    class="nl-panel"
    id="nl-panel-multiple"
    role="tabpanel"
    aria-labelledby="nl-tab-multiple"
    data-panel="multiple"
    hidden
  >
    <p class="nl-price">
      <span class="nl-price__value" data-price="multiple">&mdash;</span>
    </p>

    <p class="nl-package__descriptor" data-multi-description>
      Package pricing is loading.
    </p>

    <div class="nl-qty">
      <p class="nl-kicker">How many</p>

      <div class="nl-qty__row">
        {quantities.map((n, i) => (
          <button
            class={`nl-chip${i === 0 ? " is-active" : ""}`}
            type="button"
            aria-pressed={i === 0 ? "true" : "false"}
            data-qty={String(n)}
          >
            {n} TVs
          </button>
        ))}
      </div>
    </div>

    <button
      class="nl-action"
      type="button"
      data-nl-package-open
      disabled
    >
      <span>Book installation</span>
      <span aria-hidden="true">&rarr;</span>
    </button>
  </div>
</section>
